# ==========================================
# SMART LOST & FOUND PLATFORM - CONFIGURATION
# ==========================================

# Django Core
SECRET_KEY=django-insecure-smart-lost-found-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_NAME=smart_loss_database
DB_USER=root
DB_PASSWORD=2008
DB_HOST=localhost
DB_PORT=3306

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Email Backend Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Smart Lost & Found <noreply@smartlostfound.com>

# AI CLIP Model Settings
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
AI_MATCH_THRESHOLD_HIGH=0.75
AI_MATCH_THRESHOLD_MEDIUM=0.50
AI_MATCH_THRESHOLD_LOW=0.30
